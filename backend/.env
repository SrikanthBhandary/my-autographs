# Copy this file to .env and fill in real values for local development.
# In production, set these as real environment variables / secrets
# (Railway, Fly.io, ECS task definition, k8s Secret, etc) — never commit .env.

# --- Server ---
PORT=8081
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=autograph
DB_SSLMODE=disable

# --- JWT (owner auth) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=72

# --- S3 / object storage (images + audio uploads) ---
# For real AWS S3: leave S3_ENDPOINT blank, set S3_USE_PATH_STYLE=false
# For Cloudflare R2 / MinIO / Backblaze B2: set S3_ENDPOINT to their endpoint
# and S3_USE_PATH_STYLE=true
S3_BUCKET=autograph-uploads
S3_ENDPOINT=http://localhost:9000
S3_USE_PATH_STYLE=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/autograph-uploads
# Public URL prefix used to build the final URL stored on entries, e.g.
# https://autograph-uploads.s3.amazonaws.com or your CDN/R2 public domain
# S3_PUBLIC_BASE_URL=https://autograph-uploads.s3.amazonaws.com

# --- Share links ---
# Base URL the frontend uses to render the guest submission page;
# the backend appends /<token> when generating a share link
SHARE_BASE_URL=http://localhost:5173/submit

# --- Email notifications (SMTP) ---
# Leave SMTP_HOST blank to disable notifications entirely — the app logs a
# warning at startup and silently skips sending, nothing breaks.
#
# For local dev: point at the Mailpit container from docker-compose.yml —
# every notification email lands at http://localhost:8025 instead of a real
# inbox, no credentials needed.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@keepsake.local
SMTP_FROM_NAME=Keepsake
#
# For production, point at a real provider's SMTP relay instead, e.g.:
#   Gmail:      smtp.gmail.com : 587  (use an App Password, not your real password)
#   SendGrid:   smtp.sendgrid.net : 587  (username is literally "apikey")
#   Mailgun:    smtp.mailgun.org : 587
#   Postmark:   smtp.postmarkapp.com : 587
#   AWS SES:    email-smtp.<region>.amazonaws.com : 587
#   Resend:     smtp.resend.com : 465
